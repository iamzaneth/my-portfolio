{
  "name": "my-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:clean": "node scripts/clean-test-artifacts.mjs",
    "test:fixtures": "vite build --config tests/fixtures/vite.config.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "capture": "node scripts/capture-portfolio.mjs",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "assets:cat": "node scripts/build-cat-atlas.mjs",
    "assets:cat:check": "node scripts/build-cat-atlas.mjs --check",
    "capture:characters": "node scripts/capture-characters.mjs",
    "clean": "node scripts/clean-test-artifacts.mjs --build",
    "assets:cat:review": "node scripts/build-cat-atlas.mjs --check --review"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
